@model Sfa.Tl.ResultsAndCertification.Web.ViewModel.AdminDashboard.ReviewChangeUlnViewModel
@using Sfa.Tl.ResultsAndCertification.Common.Helpers
@using Sfa.Tl.ResultsAndCertification.Web.Content.AdminDashboard

@{
    ViewData["Title"] = ReviewChangeUln.Page_Title;
}

@section NavigationBar
{
    <vc:back-link model=Model.BackLink></vc:back-link>
}

<div class="govuk-grid-row">
    <div class="record-header">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-0">
            @ReviewChangeUln.Heading_Change_ULN
        </h1>
    </div>
    <partial name="_ValidationSummary" />
    <h2 class="govuk-heading-m">
        @ReviewChangeUln.Heading_Personal_Details
    </h2>

    <dl class="govuk-summary-list govuk-!-margin-bottom-4">
        <vc:summary-item model=Model.SummaryLearner></vc:summary-item>
        <vc:summary-item model=Model.SummaryULN></vc:summary-item>
        <vc:summary-item model=Model.SummaryProvider></vc:summary-item>
        <vc:summary-item model=Model.SummaryTlevel></vc:summary-item>
    </dl>

    <h2 class="govuk-heading-m">
        @ReviewChangeUln.Heading_Change_Summary
    </h2>

    <dl class="govuk-summary-list govuk-!-margin-bottom-4">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">@ReviewChangeUln.Title_Change_Summary_Change_Text</dt>
            <dt class="govuk-summary-list__key">@ReviewChangeUln.Title_Change_Summary_From_Text</dt>
            <dt class="govuk-summary-list__key">@ReviewChangeUln.Title_Change_Summary_To_Text</dt>
            <dt class="govuk-summary-list__key"></dt>
        </div>
        <vc:summary-item model=Model.SummaryUlnChange></vc:summary-item>
    </dl>

    <form asp-route="@RouteConstants.SubmitReviewChangeUln" asp-route-registrationPathwayId="@Model.RegistrationPathwayId" method="post">
        <input type="hidden" asp-for="RegistrationPathwayId" />
        <input type="hidden" asp-for="FirstName" />
        <input type="hidden" asp-for="LastName" />
        <input type="hidden" asp-for="Uln" />
        <input type="hidden" asp-for="UlnTo" />
        <input type="hidden" asp-for="ProviderName" />
        <input type="hidden" asp-for="ProviderUkprn" />
        <input type="hidden" asp-for="TlevelName" />
        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                    <h2 class="govuk-fieldset__heading">
                        @ReviewChangeUln.Heading_Who_has_asked_for_change
                    </h2>
                </legend>
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-label--s" for="contactname">@ReviewChangeUln.Title_Contact_Name_Text</label>
                    <input id="contactname" class="govuk-input govuk-input--width-20" asp-for="ContactName" sfa-validation-class="govuk-input-error" sfa-validation-for="ContactName" type="text" maxlength="100">
                </div>
                <div class="govuk-form-group" id="requestdate">
                    <label class="govuk-label govuk-label--s" for="dateofrequest">@ReviewChangeUln.Title_Date_Of_Request</label>
                    <div class="govuk-date-input__item">
                        <div class="govuk-form-group">
                            <label class="govuk-label govuk-date-input__label" for="day">@ReviewChangeUln.Title_Day_Text</label>
                            <input id="day" asp-for="Day" sfa-validation-for="Day" sfa-validation-class="govuk-input--error" class="govuk-input govuk-date-input__input govuk-input--width-2" inputmode="numeric" maxlength="2">
                        </div>
                    </div>
                    <div class="govuk-date-input__item">
                        <div class="govuk-form-group">
                            <label class="govuk-label govuk-date-input__label" for="month">@ReviewChangeUln.Title_Month_Text</label>
                            <input id="month" asp-for="Month" sfa-validation-for="Month" sfa-validation-class="govuk-input--error" class="govuk-input govuk-date-input__input govuk-input--width-2" inputmode="numeric" maxlength="2">
                        </div>
                    </div>
                    <div class="govuk-date-input__item">
                        <div class="govuk-form-group">
                            <label class="govuk-label govuk-date-input__label" for="year">@ReviewChangeUln.Title_Year_Text</label>
                            <input id="year" asp-for="Year" sfa-validation-for="Year" sfa-validation-class="govuk-input--error" class="govuk-input govuk-date-input__input govuk-input--width-4" inputmode="numeric" maxlength="4">
                        </div>
                    </div>
                </div>
                <div class="govuk-character-count" data-module="govuk-character-count" data-maxlength="2000">
                    <div class="govuk-form-group">
                        <label class="govuk-label govuk-label--s" for="changereason">@ReviewChangeUln.Title_Reason_For_Change_Text</label>
                        <textarea class="govuk-textarea govuk-js-character-count" id="changereason" name="changereason" rows="5" maxlength="2000" asp-for="ChangeReason"></textarea>
                        <div id="changereason-info" class="govuk-hint govuk-js-character-count__message">
                            @ReviewChangeUln.Message_You_Have_Characters_Remaining
                        </div>
                        <noscript>
                            <style type="text/css">
                                #changereason-info {
                                    display: none;
                                }
                            </style>
                            <div class="govuk-hint govuk-js-character-count__message">
                                @ReviewChangeUln.Message_You_Can_Enter_Up_To_Characters
                            </div>
                        </noscript>
                    </div>
                </div>
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-label--s" for="zenticketid">@ReviewChangeUln.Title_Zendesk_Ticket_Id</label>
                    <input id="zenticketid" class="govuk-input govuk-input--width-10" asp-for="ZendeskId" type="text" maxlength="10">
                </div>
            </fieldset>
        </div>
        <div class="govuk-button-group">
            <button id="submitButton" class="govuk-button" data-module="govuk-button" data-prevent-double-click="true">@ReviewChangeUln.Button_Submit</button>
            <a id="returnButton" class="govuk-button gov-body govuk-button--secondary" data-module="govuk-button" data-prevent-double-click="true" asp-route="@RouteConstants.AdminLearnerRecord" asp-route-pathwayid="@Model.RegistrationPathwayId">@ReviewChangeUln.Button_Cancel</a>
        </div>
    </form>
</div>